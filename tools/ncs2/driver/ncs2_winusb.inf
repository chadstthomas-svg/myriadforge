; Intel Neural Compute Stick 2 (Myriad X, MA2485) - WinUSB function driver.
;
; The OpenVINO 2022.3.1 MYRIAD plugin talks WinUSB user-mode; Windows binds
; no function driver to the stick by default, so the plugin cannot open it.
; This INF binds VID_03E7&PID_2150 (ROM/boot state, as-enumerated) and
; VID_03E7&PID_2485 (runtime, after the plugin boots the device) to the
; in-box WinUSB driver. USBDevice class (signature-exempt) + WinUSB (in-box)
; means no catalog file is needed.
;
; Modeled on the Microsoft WinUSB template INF
; (https://learn.microsoft.com/windows-hardware/drivers/usbcon/winusb-installation).
; Interface GUID matches the Intel Movidius_VSC_Device.inf for family
; resemblance; the MYRIAD plugin enumerates by VID/PID, not GUID.
;
; Install (admin):  pnputil /add-driver ncs2_winusb.inf /install

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88bae032-5a81-49f0-bc3d-a4ff138216d6}
Provider    = %ManufacturerName%
DriverVer   = 11/19/2026,2022.3.1.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceNameBoot% = USB_Install, USB\VID_03E7&PID_2150
%DeviceNameRun%  = USB_Install, USB\VID_03E7&PID_2485

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include    = winusb.inf
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName   = %WinUSB_SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WinUSB.sys

[USB_Install.Wdf]
KmdfService = WINUSB, WinUsb_Install

[WinUsb_Install]
KmdfLibraryVersion = 1.15

[USB_Install.HW]
AddReg = AddDeviceInterfaceGUID

[NoDeviceInterfaceGUID]
; Avoids adding a DeviceInterfaceGUID for a generic driver

[AddDeviceInterfaceGUID]
HKR,,DeviceInterfaceGUIDs,0x10000,%DeviceGUID%

[Strings]
ManufacturerName = "Intel"
DeviceNameBoot   = "Movidius MA2x8x (boot)"
DeviceNameRun    = "Intel Neural Compute Stick 2"
WinUSB_SvcDesc   = "WinUSB - NCS2 function driver"
DeviceGUID       = "{0E8F6DB3-0C73-46DB-B14C-0C136B0EB7E2}"
